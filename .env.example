# Backend Configuration — PT Upaya Riksa Daya
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Connection
DATABASE_URL=postgres://urd:replace_with_db_password@localhost:5433/urd_dev
TEST_DATABASE_URL=postgres://urd:replace_with_db_password@localhost:5433/urd_test

# JWT & Session Secrets (gunakan string acak minimal 32 karakter pada environment nyata)
JWT_SECRET=replace_with_random_32_byte_hex_secret
JWT_ACCESS_TTL=15m
REFRESH_SESSION_DAYS=7

# Storage
STORAGE_DIR=./storage/uploads
MAX_UPLOAD_BYTES=10485760

# Development Seed (hanya dipakai saat menjalankan npm run seed di environment non-produksi)
SEED_DEFAULT_PASSWORD=replace_with_dev_seed_password


# Pengingat otomatis ke klien. Bila SMTP/WhatsApp belum diisi, pengiriman hanya dicatat sebagai SIMULASI.
CLIENT_REMINDER_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PT Upaya Riksa Daya <urd@upayariksadaya.com>
# WhatsApp via penyedia gateway (contoh Fonnte). Token diperoleh dari penyedia.
WA_API_URL=https://api.fonnte.com/send
WA_API_TOKEN=
