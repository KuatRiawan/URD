{
  "name": "urd-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:start": "pg_ctl -D ../.local/pgdata -o '-p 5433 -k /tmp' -l ../.local/pg.log start",
    "db:stop": "pg_ctl -D ../.local/pgdata stop",
    "db:status": "pg_ctl -D ../.local/pgdata status",
    "migrate": "node src/database/migrate.js",
    "seed": "node seeds/seed.js",
    "lint": "eslint src seeds",
    "test": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.17.0",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "supertest": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
