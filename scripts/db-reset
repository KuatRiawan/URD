#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

echo "==> [PT Upaya Riksa Daya] Mereset skema database pengembangan..."

PG_BIN="/opt/homebrew/opt/postgresql@18/bin/psql"
if [ ! -x "$PG_BIN" ]; then
  PG_BIN="psql"
fi

DB_URL="${DATABASE_URL:-postgres://urd:urd_local_dev_pw@localhost:5433/urd_dev}"

"$PG_BIN" "$DB_URL" -v ON_ERROR_STOP=1 -c "DROP SCHEMA public CASCADE; CREATE SCHEMA public;"

echo "==> Menjalankan ulang migrasi database..."
npm --prefix "$ROOT_DIR/backend" run migrate

echo "==> Menjalankan ulang seed database..."
npm --prefix "$ROOT_DIR/backend" run seed

echo "==> Database berhasil direset dan siap digunakan."

